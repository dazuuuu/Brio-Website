# Brio: clean URLs (/about-us, /products/serum, /admin …) on Apache hosting.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Real files and folders (images, CSS, JS, uploads) are served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else goes to the front controller.
  RewriteRule ^ index.php [L]
</IfModule>

# Never serve hidden files (.env, .git …)
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
